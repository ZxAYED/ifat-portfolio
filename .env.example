# Copy to .env.local. Never expose these through NEXT_PUBLIC_* variables.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ifatibrahim20@gmail.com
SMTP_PASS=

# Set your own final domain before a public launch.
SITE_URL=http://localhost:3000
# Explicitly opt in only after setting your own public production URL.
SITE_INDEXING=false

# Usually empty. Optional extra trusted preview origins, separated by commas.
CONTACT_ALLOWED_ORIGINS=
