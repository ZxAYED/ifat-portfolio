{
  "name": "ifat-portfolio",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node init && node scripts/dev.mjs",
    "build": "node init && next build",
    "start": "node init && next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && node scripts/check-assets.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "motion": "14.14.0",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "~5.9.3"
  }
}
